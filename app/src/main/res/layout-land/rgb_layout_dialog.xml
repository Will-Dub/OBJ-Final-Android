<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_liste_led"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/colorView"
        android:layout_width="187dp"
        android:layout_height="187dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/cancelBtn"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginEnd="5dp"
        android:backgroundTint="#CA2222"
        android:text="@string/annuler"
        app:layout_constraintEnd_toStartOf="@+id/pickBtn"
        app:layout_constraintTop_toBottomOf="@+id/colorView" />

    <Button
        android:id="@+id/pickBtn"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:backgroundTint="@color/black"
        android:text="@string/choisir"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toTopOf="@+id/cancelBtn" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="515dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/colorView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/colorView"
        app:layout_constraintTop_toTopOf="@+id/colorView">

        <include
            android:id="@+id/redLayout"
            layout="@layout/rgb_item_layout" />

        <include
            android:id="@+id/greenLayout"
            layout="@layout/rgb_item_layout" />

        <include
            android:id="@+id/blueLayout"
            layout="@layout/rgb_item_layout" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>